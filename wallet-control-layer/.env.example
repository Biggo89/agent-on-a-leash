# Copy to .env (git-ignored). NEVER commit the real key.
LEASH_BASE_URL="https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io"
TEAM_API_KEY=""                      # issued on the day of the event
LEASH_DATA_DIR="../viseca-2026/data" # organizers' read-only data pack
LEASH_ENGINE_VERSION="leash-0.1.0"
LEASH_AUDIT_PATH="out/audit/decisions.jsonl"  # append-only decision trail
LEASH_PORT="8000"                             # our decision service

# Policy compiler. COMPILE TIME ONLY: the decision path must work with every one of these
# unset, and `make check` passes with no key at all.
LEASH_COMPILER="auto"     # auto | baseline (never call a model) | llm (must try)
LEASH_COMPILER_PROVIDER="apertus"  # openrouter | apertus — each reads only its own key below

# --- Apertus on Swisscom (default provider). Key from keymaker.ai-weeks.ch —
# it EXPIRES AFTER 60 MINUTES, after which every compile is an HTTP 401 and falls back to the
# baseline. One model per endpoint, so there is no routing tier: Apertus or the baseline.
SWISSCOM_API_KEY="""
# APERTUS_MODEL="swiss-ai/Apertus-v1.5-70B"   # the default; override only if Swisscom renames it
# APERTUS_BASE_URL="https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1"

# --- OpenRouter
OPENROUTER_API_KEY=""
# Chosen by measurement, not by tier: 0 facets missed and 0 invented across the five pack
# instructions, ~$0.009 each. Opus 5 costs 5x for no more accuracy; the flash-lite tier
# drops facets the decision board depends on. Benchmark table in compile/llm.py.
# It IS a reasoning model (~785 reasoning tokens a compile) — fine, because max_tokens
# budgets for it. Models that spend the WHOLE budget thinking return nothing at all
# (measured 2026-09-08: qwen3.8-flash 0 characters, gemini-3.8-flash truncated mid-JSON).
# Both fell back to the baseline correctly; check compiler_notes if output looks thin.
LEASH_COMPILER_MODEL="google/gemini-3.7-flash"
# OpenRouter routes here if the primary is down or rate-limited, before we fall back to the
# regex baseline. Set to "" to disable routing: this model or the baseline, nothing else.
LEASH_COMPILER_FALLBACK_MODELS="anthropic/claude-opus-5,google/gemini-3.5-flash-lite"
LEASH_COMPILER_TIMEOUT_S="60"  # no platform deadline is anywhere near this call

# --- The connector (MCP at /mcp) and the mock Payment App. All defaults work offline.
WALLET_APP_URL="http://127.0.0.1:8081"              # where the connector introspects tokens (make payment-app)
WALLET_INTROSPECTION_SECRET="dev-introspection-secret"  # shared by the app and the connector; a mock's shortcut
WALLET_APP_STATE="out/payment-app.json"             # the app's memory: registered agents, tokens, consents
LEASH_PUBLIC_URL=""                                 # the connector's public https URL when tunnelled; else derived per request
